{
  "name": "ark-security-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "ARK STUDIOS Security Operations Dashboard — engagement tracking, findings, attack simulation and presentation mode.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.js",
    "start": "npm-run-all --parallel dev server",
    "validate": "node tools/validate-content.js",
    "new": "node tools/new.js",
    "soc:demo": "node tools/soc-agent-example.js"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.7.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=18"
  }
}
